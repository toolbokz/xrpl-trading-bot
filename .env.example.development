# ============================================================================================
# .env.example.development — XRPL Trading Bot
# ============================================================================================
#
# DEVELOPMENT configuration template.
# Copy to .env and edit as needed. Designed for testnet quick-boot.
#
# Philosophy:
#   - Testnet defaults — connect to testnet, paper trading ON.
#   - Local seed signing ALLOWED (testnet only).
#   - Verbose logging, fast tick loop, liberal staleness thresholds.
#   - Risk checks remain ON. Risk is never disabled, even in dev.
#   - Dev-mode proxy header bypass enabled (Next.js dev server adds x-forwarded-for).
#
# Quick start:
#   1. cp .env.example.development .env
#   2. npm run faucet               # creates testnet wallet, prints seed
#   3. Paste XRPL_SEED_TESTNET below
#   4. npm run dev                   # starts dashboard + bot
#
# ============================================================================================


# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME IDENTITY
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Verbose logging for development. Switch to 'info' to reduce noise.
# Consumed by: src/analytics/logger.ts (pino), src/config/index.ts
LOG_LEVEL=debug

# Dashboard HTTP port. Bound to 127.0.0.1 only.
# Consumed by: web/server.js
PORT=3000


# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: LOCALHOST-ONLY EXECUTION
# Enforced by: src/security/localOnly.ts, web/lib/localApi/withLocalApi.ts
# ─────────────────────────────────────────────────────────────────────────────

# Not required in development (only enforced when NODE_ENV=production).
# Consumed by: src/security/safetyPolicy.ts
# BOT_LOCAL_ONLY=true

# Remote access override. Leave commented out — dev is already localhost-only.
# BOT_ALLOW_REMOTE=false

# Next.js dev server adds x-forwarded-for headers. This skips proxy header rejection.
# NEVER set to true in production. Consumed by: web/lib/localApi/withLocalApi.ts
BOT_API_DEV_MODE=true


# ─────────────────────────────────────────────────────────────────────────────
# XRPL NETWORK & CONNECTION — TESTNET
# Consumed by: src/config/index.ts → XRPLConfig, src/xrpl/sharedClient.ts
# ─────────────────────────────────────────────────────────────────────────────

# Testnet for development. signer.ts allows SeedSigner when this is not 'mainnet'.
XRPL_NETWORK=testnet

# Testnet public WebSocket endpoint.
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233

# Optional failover endpoints (testnet).
# XRPL_WSS_URLS=wss://s.altnet.rippletest.net:51233

# Reconnection policy — more aggressive for dev iteration.
XRPL_MAX_RECONNECTS=5
XRPL_RECONNECT_DELAY_MS=500
XRPL_RECONNECT_MAX_DELAY_MS=15000

# Rate-limit cooldown (ms). Shorter for dev.
# XRPL_429_COOLDOWN_MS=60000

# Connection timeout (ms).
XRPL_CONNECT_TIMEOUT_MS=10000


# ─────────────────────────────────────────────────────────────────────────────
# WALLET & SIGNING — DEVELOPMENT (TESTNET SEED)
# Consumed by: src/xrpl/signer.ts, src/xrpl/wallet.ts, src/config/index.ts
#
# On testnet (XRPL_NETWORK=testnet), SeedSigner is ALLOWED.
# Generate a testnet wallet with: npm run faucet
# ─────────────────────────────────────────────────────────────────────────────

# Testnet wallet seed. Paste the secret from `npm run faucet`.
# This is ONLY used when XRPL_NETWORK=testnet. Ignored on mainnet.
XRPL_SEED_TESTNET=sEdSjhKVHx1LUu89Nx7bKDeXBqu4JUC

# Alternative: secret numbers format (comma-separated).
# XRPL_SECRET_NUMBERS_TESTNET=

# Legacy env vars (also checked as fallback):
# XRPL_SEED=
# WALLET_SEED=

# Signer readiness validation. true skips dry-run signing check.
# Safe to enable in dev for faster startup iteration.
# Consumed by: src/xrpl/signer.ts → assertSignerReady()
SIGNER_SKIP_READY_CHECK=true


# ─────────────────────────────────────────────────────────────────────────────
# TRADING MODE
# Consumed by: src/config/index.ts, src/security/safetyPolicy.ts
# ─────────────────────────────────────────────────────────────────────────────

# Paper trading = simulated execution. No real XRPL transactions.
# Keep true while developing. Set false to test real testnet transactions.
PAPER_TRADING=false

# Testnet faucet. Enable to auto-fund wallet on startup (testnet only).
# Consumed by: src/config/index.ts
ENABLE_TESTNET_FAUCET=true


# ─────────────────────────────────────────────────────────────────────────────
# TRADING PAIR — TESTNET
# Consumed by: src/config/index.ts → TradingPair
# Note: Mainnet issuers may not exist on testnet. The bot handles this gracefully
# (empty order books, no liquidity). For real testnet testing, use a testnet issuer.
# ─────────────────────────────────────────────────────────────────────────────

TRADE_BASE_CURRENCY=XRP
TRADE_QUOTE_CURRENCY=RLUSD

# Mainnet issuer (used as reference; may not exist on testnet — that's OK).
TRADE_QUOTE_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
# TRADE_BASE_ISSUER=
TRADE_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# ─────────────────────────────────────────────────────────────────────────────
# INSTRUMENT REGISTRY
# Consumed by: src/market/instrumentRegistry/db.ts, src/market/issuerRouter.ts
# ─────────────────────────────────────────────────────────────────────────────

INSTRUMENT_DB_PATH=data/instruments.sqlite

# Use registry for issuer resolution.
ISSUER_ROUTER_USE_REGISTRY=true

# Allow legacy env-var issuers as fallback (useful when testing new pairs not yet in registry).
ISSUER_ROUTER_ALLOW_LEGACY=true

# Accept any issuer tier in dev (including unverified/custom).
# ISSUER_ROUTER_MIN_TIER=custom


# ─────────────────────────────────────────────────────────────────────────────
# RISK CONTROLS — DEVELOPMENT SIZING
# Consumed by: src/config/index.ts → RiskConfig, StrategyConfig
# Enforced by: src/risk/riskEngine.ts, src/risk/hardRiskGuard.ts
#
# Risk is NEVER disabled. Even in dev, every trade passes through RiskEngine
# and HardRiskGuard. The values below are testnet-appropriate.
# ─────────────────────────────────────────────────────────────────────────────

# Small position sizes for testnet testing.
POSITION_SIZE_XRP=5

# Generous limits for testnet (faucet-funded wallets have 1000 XRP).
MAX_TRADE_SIZE=1000
MAX_DAILY_LOSS_XRP=500
MAX_EXPOSURE_PER_ISSUER=5000

# Lower reserve floor for testnet (base reserve is 10 XRP on testnet).
RESERVE_FLOOR_XRP=25

# RESERVE_BUFFER_XRP=0
# RESERVE_BUFFER_BPS=0

CONSECUTIVE_FAILURE_KILL_SWITCH=5

# Liberal slippage for testnet (thin order books).
MAX_SLIPPAGE_BPS=100
EXECUTION_SLIPPAGE_BPS_DEFAULT=5
EXECUTION_MAX_SLIPPAGE_BPS_VS_MID=30
EXECUTION_ALLOW_PARTIAL_SIZING=false

ISSUER_BLACKLIST=


# ─────────────────────────────────────────────────────────────────────────────
# HARD RISK GUARD — DEVELOPMENT THRESHOLDS
# Consumed by: src/risk/hardRiskGuard.ts → loadHardRiskConfig()
# Still enforced in dev. Values are relaxed for testnet thin markets.
# ─────────────────────────────────────────────────────────────────────────────

HARD_RISK_MAX_EXPOSURE=50000
HARD_RISK_MAX_SKEW_PCT=80
HARD_RISK_MAX_DRAWDOWN_PCT=15
HARD_RISK_MAX_BALANCE_STALE_MS=60000
HARD_RISK_MIN_FEED_HEALTH=20


# ─────────────────────────────────────────────────────────────────────────────
# CAPITAL PROTECTION ENGINE — DEVELOPMENT
# Consumed by: src/risk/capitalProtection.ts → loadCapitalProtectionConfig()
# ─────────────────────────────────────────────────────────────────────────────

CAPITAL_PROTECTION_ENABLED=true
CP_LOOKBACK_TRADES=200
CP_MIN_TRADES=50
CP_MAX_ROLLING_DRAWDOWN_PCT=15
CP_MIN_PROFIT_FACTOR=0.90
CP_MIN_EXPECTANCY_BPS=-10
CP_MAX_AVG_SLIPPAGE_BPS=100
CP_MAX_PARTIAL_FILL_RATE=0.60
CP_CONSEC_FAIL_SHUTDOWN=15
CP_THROTTLE_COOLDOWN_MS=5000
CP_PAUSE_COOLDOWN_MS=30000
CP_SIZE_THROTTLE_MULT=0.5
CP_SIZE_PAUSE_MULT=0.0


# ─────────────────────────────────────────────────────────────────────────────
# EXPOSURE PERSISTENCE — DEVELOPMENT
# Consumed by: src/risk/exposureTracker.ts, src/persistence/exposureStore.ts
# ─────────────────────────────────────────────────────────────────────────────

# Enable persistence for dev (rehydrates position state across restarts).
# Set to false for pure stateless iteration.
EXPOSURE_PERSISTENCE=true
EXPOSURE_DB_PATH=data/exposure.sqlite


# ─────────────────────────────────────────────────────────────────────────────
# STRATEGY CONFIGURATION — DEVELOPMENT
# Consumed by: src/config/index.ts → StrategyConfig
# ─────────────────────────────────────────────────────────────────────────────

# Lower spread threshold for testnet (wider spreads are normal).
MIN_SPREAD_BPS=5

STOP_LOSS_BPS=100

# Volatility-adaptive stop-loss (disabled by default; legacy behavior unchanged).
VOL_STOP_ENABLED=false
VOL_STOP_WARMUP_MS=60000
VOL_STOP_MIN_SAMPLES=50
VOL_STOP_ALPHA=0.2
VOL_STOP_MULTIPLIER=2.0
VOL_STOP_MIN_BPS=50
VOL_STOP_MAX_BPS=250
VOL_STOP_USE_FOR_ENHANCED=true

# Faster cooldown for dev iteration.
COOLDOWN_MS=10000

# Lower profit thresholds for testnet.
AMM_ARB_MIN_PROFIT_BPS=10
PATH_ARB_MIN_PROFIT_BPS=10

# Liberal staleness for testnet (slower ledger close times).
ORDERBOOK_STALE_MS=15000


# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION QUALITY & REPRICE POLICY — DEVELOPMENT
# Consumed by: src/execution/repricePolicy.ts → loadRepriceConfig()
# ─────────────────────────────────────────────────────────────────────────────

# Wider drift tolerance for testnet thin books.
REPRICE_DRIFT_THRESHOLD_BPS=10

# Liberal staleness for dev.
REPRICE_HARD_STALENESS_MS=30000

# Higher churn limit for fast dev iteration.
REPRICE_CHURN_LIMIT_PER_MIN=20


# ─────────────────────────────────────────────────────────────────────────────
# FLOW METRICS & REGIME CLASSIFICATION — DEVELOPMENT
# Consumed by: src/config/index.ts → FlowConfig
# ─────────────────────────────────────────────────────────────────────────────

FLOW_WINDOW_MS=60000
FLOW_AGGRESSION_WINDOW_MS=10000
FLOW_DEPTH_LEVELS=10
FLOW_TRENDING_THRESHOLD=0.3
FLOW_CHAOTIC_SPREAD_BPS=500
FLOW_MIN_TRADES_LIQUIDITY=1
FLOW_MIN_DEPTH_LIQUIDITY=10
FLOW_QUIET_THRESHOLD=0.1
FLOW_ENABLE_REGIME_FILTER=true
FLOW_ENABLE_ADVERSE_SELECTION=true
FLOW_MAX_QUOTE_SKEW_BPS=20


# ─────────────────────────────────────────────────────────────────────────────
# PATH ARBITRAGE CIRCUIT BREAKER — DEVELOPMENT
# Consumed by: src/strategies/pathArbitrage.ts, src/persistence/breakerStore.ts
# ─────────────────────────────────────────────────────────────────────────────

# File-based for dev (no Redis dependency required).
PATH_ARB_BREAKER_STORE=file

# Circuit breaker limits — relaxed for testnet.
PATH_ARB_CIRCUIT_BREAKER_MAX_LOSS_BPS=1000
PATH_ARB_CIRCUIT_BREAKER_WINDOW_MS=300000
PATH_ARB_CIRCUIT_BREAKER_COOLDOWN_MS=60000


# ─────────────────────────────────────────────────────────────────────────────
# MONITORING & INFRASTRUCTURE SAFETY — DEVELOPMENT
# Consumed by: src/monitoring/eventLoopLag.ts, src/monitoring/cpuWatchdog.ts,
#              src/monitoring/perfTracer.ts, src/utils/sleep.ts, src/utils/rateLimiter.ts
# ─────────────────────────────────────────────────────────────────────────────

# Higher lag tolerance for dev (debugger, hot-reload add latency).
EVENT_LOOP_LAG_LIMIT_MS=500

# EVENT_LOOP_SAMPLE_INTERVAL_MS=500

# Higher CPU tolerance for dev (TypeScript compilation, HMR).
CPU_MAX_PERCENT=80
CPU_MAX_DURATION_MS=10000

# Faster tick loop for dev iteration (still above 25ms floor).
BOT_LOOP_MIN_DELAY_MS=50

# Higher TPS limit for dev.
STRATEGY_MAX_TPS=20

# More frequent perf summaries.
PERF_SUMMARY_INTERVAL_MS=15000

# Higher log rate for dev.
LOG_MAX_PER_SEC=50


# ─────────────────────────────────────────────────────────────────────────────
# AVAILABILITY SCANNER — DEVELOPMENT
# Consumed by: src/market/availabilityScanner.ts → loadAvailabilityScannerConfig()
# ─────────────────────────────────────────────────────────────────────────────

# Less frequent scanning in dev to reduce testnet RPC load.
# AVAILABILITY_SCAN_INTERVAL_MS=120000
# AVAILABILITY_REQUEST_TIMEOUT_MS=10000
# AVAILABILITY_PROBE_TRUSTLINES=true
# AVAILABILITY_PROBE_ORDERBOOKS=true
# AVAILABILITY_MIN_DEPTH_NOTIONAL=10


# ─────────────────────────────────────────────────────────────────────────────
# TRUSTLINE GOVERNANCE — DEVELOPMENT
# Consumed by: src/market/trustlineGovernance.ts
# ─────────────────────────────────────────────────────────────────────────────

# TRUSTLINE_AUTO_ENSURE=true
# TRUSTLINE_REQUIRE_REGISTERED=false
# TRUSTLINE_DEFAULT_LIMIT=1000000000


# ─────────────────────────────────────────────────────────────────────────────
# LIQUIDITY INTELLIGENCE — DEVELOPMENT
# Consumed by: src/market/liquidityIntelligence.ts → loadLiquidityConfig()
# ─────────────────────────────────────────────────────────────────────────────

# LIQUIDITY_SPREAD_WINDOW_SIZE=60
# LIQUIDITY_FLOW_WINDOW_MS=60000


# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION PAIR RESOLVER — DEVELOPMENT
# Consumed by: src/market/executionPairResolver.ts → loadExecutionPairResolverConfig()
# ─────────────────────────────────────────────────────────────────────────────

# Shorter cache TTL for dev (see changes faster).
# PAIR_RESOLVER_CACHE_TTL_MS=60000

# Don't hard-fail in dev when a pair can't be resolved (testnet issuers may not exist).
PAIR_RESOLVER_FAIL_ON_UNRESOLVABLE=false


# ─────────────────────────────────────────────────────────────────────────────
# TRADE TAPE — DEVELOPMENT
# Consumed by: src/market/tradeTape.ts, src/market/tradeTapeService.ts
# ─────────────────────────────────────────────────────────────────────────────

TRADE_TAPE_MAX_SIZE=500
TRADE_TAPE_IGNORE_SELF=false
TRADE_TAPE_ENABLED=true


# ─────────────────────────────────────────────────────────────────────────────
# ADAPTIVE LEARNING — DEVELOPMENT
# Consumed by: src/analytics/adaptiveConfig.ts, src/analytics/adaptiveLearner.ts,
#              src/analytics/adaptiveScheduler.ts
# ─────────────────────────────────────────────────────────────────────────────

ADAPTIVE_LEARNING_ENABLED=true
ADAPTIVE_LOOKBACK_HOURS=4
ADAPTIVE_MIN_SAMPLES=10
ADAPTIVE_UPDATE_INTERVAL_MIN=5
ADAPTIVE_ALPHA=0.3
ADAPTIVE_MAX_SIZE_STEP=0.15
ADAPTIVE_MAX_SLIPPAGE_STEP=15
ADAPTIVE_STATE_PATH=data/adaptive-state.json


# ─────────────────────────────────────────────────────────────────────────────
# REGIME POLICY — DEVELOPMENT
# Consumed by: src/analytics/regimePolicy.ts → loadRegimePolicyConfig()
# ─────────────────────────────────────────────────────────────────────────────

REGIME_POLICY_ENABLED=true
REGIME_POLICY_LOOKBACK_HOURS=8
REGIME_POLICY_MIN_TRADES=10
REGIME_POLICY_ALPHA=0.3
REGIME_DISABLE_SCORE_BPS=-10
REGIME_ENABLE_SCORE_BPS=1
REGIME_MIN_SIZE=0.2
REGIME_MAX_SIZE=2.0
REGIME_SIZE_STEP=0.1


# ─────────────────────────────────────────────────────────────────────────────
# FEEDBACK ENGINE (ANALYTICS PERSISTENCE) — DEVELOPMENT
# Consumed by: src/analytics/feedbackDb.ts, src/analytics/feedbackEngine.ts
# ─────────────────────────────────────────────────────────────────────────────

FEEDBACK_DB_PATH=data/feedback.sqlite
FEEDBACK_RETENTION_DAYS=7
FEEDBACK_DB_VERBOSE=true
SNAPSHOT_FLUSH_INTERVAL=1


# ─────────────────────────────────────────────────────────────────────────────
# API AUTHENTICATION — DEVELOPMENT
# Consumed by: web/lib/localApi/withLocalApi.ts
# ─────────────────────────────────────────────────────────────────────────────

# No API token required in dev (skip header validation).
# LOCAL_API_TOKEN=

# Audit rollout flags (default OFF; safe to enable incrementally)
FEATURE_AUDIT_GUARDS=0
FEATURE_STRICT_CONFIG=0
FEATURE_EXEC_TELEMETRY=0

# Optional health/guard timeout tuning (ms)
BOT_WIRING_HEALTH_TIMEOUT_MS=3500
XRPL_RESERVE_REQUEST_TIMEOUT_MS=4000
EXECUTION_IDEMPOTENCY_WINDOW_MS=15000

# PnL export path.
CSV_EXPORT_PATH=pnl.csv
