# ============================================================================================
# .env.example — XRPL Trading Bot
# ============================================================================================
# Copy this file to .env and fill in your values.
# See docs/config.md for detailed documentation.
# ============================================================================================

# [runtime]
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# [security.localhost]
BOT_LOCAL_ONLY=true
BOT_ALLOW_REMOTE=false
BOT_API_DEV_MODE=false
LOCAL_API_TOKEN=

# [xrpl]
XRPL_NETWORK=mainnet
XRPL_WSS_URL=wss://xrplcluster.com

# [wallet]
XRPL_SECRET=
# XRPL_SECRET_NUMBERS=

# [trading]
BASE_CURRENCY=XRP
QUOTE_CURRENCY=RLUSD
QUOTE_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De
DRY_RUN=true

# [sizing]
BASE_ORDER_SIZE_XRP=1.2
EXECUTION_MIN_BASE_FRAC=0.25
