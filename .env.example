# XRPL Trading Bot - minimal env template (important vars only)
#
# Full development template: .env.example.development
# Full env inventory (long tail): audits/env_var_inventory.tsv

# ----------------------------------------------------------------------------
# Runtime mode
# ----------------------------------------------------------------------------
NODE_ENV=development
PAPER_TRADING=true
SINGLE_PROCESS_MODE=true

# ----------------------------------------------------------------------------
# Localhost security
# ----------------------------------------------------------------------------
BOT_LOCAL_ONLY=true
# BOT_ALLOW_REMOTE=false
# BOT_API_DEV_MODE=false
LOCAL_API_TOKEN=replace-with-long-random-token

# ----------------------------------------------------------------------------
# XRPL connectivity
# ----------------------------------------------------------------------------
XRPL_NETWORK=mainnet
XRPL_WSS_URL=wss://xrplcluster.com
# XRPL_WSS_URLS=wss://xrplcluster.com,wss://s1.ripple.com

XRPL_REQUEST_TIMEOUT_MS=8000
XRPL_CONNECT_TIMEOUT_MS=10000
XRPL_429_COOLDOWN_MS=600000
XRPL_MAX_RECONNECTS=10
XRPL_RECONNECT_DELAY_MS=1000
XRPL_RECONNECT_MAX_DELAY_MS=30000
XRPL_RESERVE_REQUEST_TIMEOUT_MS=4000

# ----------------------------------------------------------------------------
# Trading pair
# ----------------------------------------------------------------------------
TRADE_BASE_CURRENCY=XRP
TRADE_QUOTE_CURRENCY=RLUSD
TRADE_QUOTE_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De

# ----------------------------------------------------------------------------
# Risk controls
# ----------------------------------------------------------------------------
MAX_EXPOSURE_PER_ISSUER=5000
MAX_TRADE_SIZE=1000
POSITION_SIZE_XRP=5
MAX_DAILY_LOSS_XRP=500
CONSECUTIVE_FAILURE_KILL_SWITCH=5
RESERVE_FLOOR_XRP=25

# ----------------------------------------------------------------------------
# Execution controls
# ----------------------------------------------------------------------------
MAX_SLIPPAGE_BPS=50
EXECUTION_SLIPPAGE_BPS_DEFAULT=5
EXECUTION_MAX_SLIPPAGE_BPS_VS_MID=30
EXECUTION_ALLOW_PARTIAL_SIZING=false
EXECUTION_ORDER_TYPE=IOC
EXECUTION_MIN_BASE=0.25
EXECUTION_MIN_QUOTE=0.1
EXECUTION_DEPTH_LEVELS=5
EXECUTION_IOC_MIN_FILL_RATIO=1
EXECUTION_REPRICE_MAX_BPS=3
EXECUTION_LAST_LEDGER_SLACK=8
EXECUTION_IDEMPOTENCY_WINDOW_MS=15000

# ----------------------------------------------------------------------------
# Audit rollout flags (default OFF)
# ----------------------------------------------------------------------------
FEATURE_AUDIT_GUARDS=0
FEATURE_STRICT_CONFIG=0
FEATURE_EXEC_TELEMETRY=0
