# =============================================================================
# XRPL Trading Bot Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# =============================================================================
# 🔒 SECURITY: Localhost-Only Execution
# =============================================================================
# This bot is LOCKED to localhost-only execution by default.
# Remote/cloud deployment is BLOCKED to protect your funds.

# Enable localhost-only enforcement (default: true)
# When true, bot refuses to start on cloud platforms or accept remote requests
BOT_LOCAL_ONLY=true

# DANGEROUS: Override localhost-only restriction
# Set to 'true' ONLY if you understand the security risks
# and need to run in a container or non-standard environment
# BOT_ALLOW_REMOTE=false

# =============================================================================
# XRPL Network Configuration
# =============================================================================

# Network: 'mainnet' or 'testnet'
XRPL_NETWORK=testnet

# WebSocket endpoint
# Mainnet options:
#   wss://s1.ripple.com
#   wss://s2.ripple.com
#   wss://xrplcluster.com
# Testnet:
#   wss://s.altnet.rippletest.net:51233
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233

# =============================================================================
# Wallet Configuration (CHOOSE ONE METHOD)
# =============================================================================

# Option 1: Seed (base58-encoded secret)
# XRPL_SEED=sEd...your-seed-here

# Option 2: Secret Numbers (8 comma-separated numbers from hardware wallet)
XRPL_SECRET_NUMBERS=YOUR_SECRET_NUIMBERS_HERE

# =============================================================================
# Trading Pair Configuration
# =============================================================================

# Base currency (what you're trading)
TRADE_BASE_CURRENCY=XRP

# Quote currency (what you're pricing in)
TRADE_QUOTE_CURRENCY=RLUSD

# Token issuer address
TRADE_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De

# =============================================================================
# Trading Safety Settings
# =============================================================================

# Paper trading mode (simulated trades, no real execution)
PAPER_TRADING=true

# Position size in XRP per trade
POSITION_SIZE_XRP=2

# Maximum slippage in basis points (100 bps = 1%)
MAX_SLIPPAGE_BPS=50

# Maximum single trade size in XRP
MAX_TRADE_SIZE=50

# Maximum daily loss in XRP before halting
MAX_DAILY_LOSS_XRP=100

# Minimum XRP reserve to maintain
RESERVE_FLOOR_XRP=50

# Enable testnet faucet for funding (testnet only)
ENABLE_TESTNET_FAUCET=false

# =============================================================================
# Bot API Authentication (HMAC + RBAC)
# =============================================================================

# Development mode: skip auth for localhost dashboard (NEVER use in production!)
# Set to 'true' only for local development with `npm run dev`
BOT_API_DEV_MODE=true

# API Keys (REQUIRED for production - JSON array format)
# Generate secrets with: openssl rand -hex 32
# Format: '[{"id":"key-id","secret":"64-char-hex","role":"admin|operator|readonly"}]'
#
# Roles:
#   admin    - Full access (run, pause, kill, orders, cancel)
#   operator - Order management (orders, position size, trading pair)
#   readonly - Read-only access (status, wallet, trades, price)
#
# IMPORTANT: The value MUST be a JSON array string. Raw hex will cause auth to fail!
# Correct:   BOT_API_KEYS='[{"id":"admin-key","secret":"abc123...","role":"admin"}]'
# WRONG:     BOT_API_KEYS=abc123... (this will fail)
#
BOT_API_KEYS='[{"id":"admin-key-01","secret":"52ed1386f306c1a6633eec87fd9863c52ff3700732da58cf6ca1388c28f87955","role":"admin"}]'

# Timestamp tolerance for request validation (milliseconds)
# BOT_AUTH_TIMESTAMP_TOLERANCE_MS=60000

# Nonce TTL for replay protection (milliseconds)
# BOT_AUTH_NONCE_TTL_MS=300000

# Rate limiting window (milliseconds)
# BOT_AUTH_RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per rate limit window
# BOT_AUTH_RATE_LIMIT_MAX_REQUESTS=100

# IP allowlist (comma-separated, empty = allow all)
# BOT_AUTH_IP_ALLOWLIST=127.0.0.1,::1

# Redis URL for distributed nonce/rate limiting (optional)
# Required for multi-instance deployments
# BOT_AUTH_REDIS_URL=redis://localhost:6379

# =============================================================================
# Path Arbitrage Strategy
# =============================================================================

# Enable path arbitrage (default: false - strategy disabled)
PATH_ARB_ENABLED=false

# Dry-run mode: log opportunities without executing (default: true when enabled)
PATH_ARB_DRY_RUN=true

# Circuit breaker: max cumulative loss in basis points before halting
PATH_ARB_CIRCUIT_BREAKER_MAX_LOSS_BPS=500

# Circuit breaker: time window to track losses (milliseconds)
PATH_ARB_CIRCUIT_BREAKER_WINDOW_MS=300000

# Circuit breaker: cooldown after tripping (milliseconds)
PATH_ARB_CIRCUIT_BREAKER_COOLDOWN_MS=600000

# Minimum profit in basis points to execute path arbitrage
# PATH_ARB_MIN_PROFIT_BPS=20

# =============================================================================
# Logging & Monitoring
# =============================================================================

# Log level: 'debug', 'info', 'warn', 'error'
# LOG_LEVEL=info

# Enable structured JSON logging
# LOG_JSON=false
