{
    "name": "xrpl-trading-bot",
    "version": "0.1.0",
    "description": "Production-grade XRPL trading bot with risk controls and paper trading mode",
    "private": true,
    "main": "dist/index.js",
    "type": "commonjs",
    "scripts": {
        "build:backend": "tsc -p tsconfig.json",
        "build:frontend": "next build src/ui",
        "build": "npm run build:backend && npm run build:frontend",
        "start": "NODE_ENV=production BOT_LOCAL_ONLY=true SINGLE_PROCESS_MODE=true node server.js",
        "dev": "BOT_LOCAL_ONLY=true SINGLE_PROCESS_MODE=true next dev src/ui -H 127.0.0.1",
        "dashboard": "BOT_LOCAL_ONLY=true SINGLE_PROCESS_MODE=true node server.js",
        "lint": "next lint src/ui --no-inline-config",
        "faucet": "ts-node --transpile-only scripts/createTestnetWallet.ts",
        "sync:instruments": "ts-node --transpile-only scripts/syncInstrumentRegistrySeeds.ts",
        "fund:rlusd:testnet": "ts-node --transpile-only scripts/fundExistingRlusdTestnet.ts",
        "encrypt:mainnet-secret": "ts-node --transpile-only scripts/encrypt-mainnet-secret-numbers.ts",
        "test": "vitest",
        "clean": "rm -rf dist src/ui/.next .next",
        "reinstall": "npm run clean && npm install"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "better-sqlite3": "^12.6.2",
        "clsx": "^2.1.1",
        "dotenv": "^16.4.5",
        "lightweight-charts": "^4.2.1",
        "lucide-react": "^0.468.0",
        "next": "14.2.4",
        "node-fetch": "^3.3.2",
        "pino": "^8.17.2",
        "pino-pretty": "^11.2.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "recharts": "^2.10.4",
        "redis": "^4.6.12",
        "uuid": "^9.0.1",
        "ws": "^8.16.0",
        "xrpl": "^3.1.0",
        "xrpl-secret-numbers": "^0.3.5",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.0",
        "@types/uuid": "^9.0.7",
        "@types/ws": "^8.5.10",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-next": "14.2.4",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.14",
        "ts-node": "^10.9.2",
        "typescript": "5.4.5",
        "vitest": "^4.0.18"
    }
}
